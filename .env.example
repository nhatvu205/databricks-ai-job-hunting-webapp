# Used by the Streamlit and MCP apps. On Databricks, configure these as app values/secrets.
JOB_COPILOT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_copilot
JOB_COPILOT_CATALOG=main
JOB_COPILOT_SCHEMA_NAME=job_copilot
JOB_COPILOT_VECTOR_SEARCH_ENDPOINT=job-copilot-vs
JOB_COPILOT_VECTOR_SEARCH_INDEX=main.job_copilot.job_documents_index
JOB_COPILOT_MODEL_ENDPOINT=databricks-claude-sonnet-4-5
JOB_COPILOT_DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# Prefer Databricks Apps service-principal/OAuth authentication. This is for local development only.
JOB_COPILOT_DATABRICKS_TOKEN=
